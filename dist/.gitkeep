body {
  margin: 0;
  overflow: hidden;
  background: radial-gradient(circle at top, #111827 0%, #0b1020 45%, #050b16 100%);
  color: #ffffff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  user-select: none;
}

#canvas-container {
  width: 100vw;
  height: 100vh;
}

#hud {
  position: absolute;
  top: 20px;
  left: 20px;
  z-index: 10;
  color: #f8fafc;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(103, 232, 249, 0.32);
  border-radius: 16px;
  padding: 16px 20px 14px 20px;
  backdrop-filter: blur(10px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  pointer-events: none;
}

.title {
  font-size: 12px;
  letter-spacing: 3px;
  font-weight: 800;
  color: #f472b6;
  margin-bottom: 5px;
}

.speed-row {
  display: flex;
  align-items: flex-end;
  gap: 8px;
}

#speed-display {
  font-size: 40px;
  font-weight: 900;
  color: #67e8f9;
  line-height: 1;
}

.unit {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #94a3b8;
  margin-bottom: 6px;
}

#status-text {
  margin-top: 8px;
  font-size: 13px;
  letter-spacing: 1px;
  color: #cbd5e1;
  text-transform: uppercase;
}

#controls-hint {
  margin-top: 8px;
  font-size: 11px;
  color: #b6c2d9;
  letter-spacing: 0.4px;
}

#version-badge {
  position: absolute;
  right: 18px;
  bottom: 18px;
  z-index: 10;
  font-size: 11px;
  letter-spacing: 1.5px;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(15, 23, 42, 0.35);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 6px 8px;
  border-radius: 999px;
}

canvas {
  display: block;
}
